# Production build defaults. VITE_USE_EMULATORS is deliberately EMPTY: the
# committed .env sets it to 1 for development, and a production bundle that
# inherited it would try to reach 127.0.0.1 emulators from the user's phone.
# CI overwrites the project values via .env.production.local.
VITE_USE_EMULATORS=
VITE_FB_PROJECT_ID=money-kids-dev
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_STORAGE_BUCKET=
