# Copy to .env.local if you need to point the app somewhere other than the
# local emulators. You do NOT need to do this for normal development: the
# committed .env already works against `npm run emulators`.
#
#   cp app/.env.example app/.env.local
#
# Vite loads, in increasing order of precedence:
#   .env                 committed, emulator defaults (dev/test)
#   .env.production      committed, blanks the emulator flag for real builds
#   .env.local           yours, gitignored, overrides both
#   .env.production.local  written by CI at build time; gitignored
#
# IMPORTANT: every VITE_-prefixed variable is inlined into the JavaScript
# bundle that ships to the browser. Anyone can read them with devtools. None of
# these are secrets — the Firebase web config is public by design, and access
# is controlled by Firestore/Storage rules and the callables, not by hiding
# these values. Never put an API secret, service-account key or admin
# credential in a VITE_ variable.

# 1 = talk to the local emulators (127.0.0.1). Empty/absent = talk to the real
# project named below. Must be EMPTY for anything you deploy, or phones will
# try to reach 127.0.0.1.
VITE_USE_EMULATORS=1

# The Firebase project these point at. With emulators on, the values only need
# to be well-formed — nothing contacts Google.
VITE_FB_PROJECT_ID=money-kids-test
VITE_FB_API_KEY=demo-key
VITE_FB_AUTH_DOMAIN=localhost
VITE_FB_STORAGE_BUCKET=money-kids-test.appspot.com

# To run the app against the real project instead, use values from
# `firebase apps:sdkconfig web --project <id>` and leave VITE_USE_EMULATORS
# empty. Be aware you are then writing to real family data.
