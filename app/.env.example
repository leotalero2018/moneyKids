# Template. You do NOT need to copy this for normal development: the committed
# .env already works against `npm run emulators`.
#
# Vite loads these in order, and LATER FILES WIN:
#
#   1. .env                    committed — emulator defaults, every mode
#   2. .env.local              yours, gitignored — every mode
#   3. .env.<mode>             committed — e.g. .env.production
#   4. .env.<mode>.local       yours, gitignored — e.g. .env.production.local
#
# The order matters and is easy to get backwards: .env.production OVERRIDES
# .env.local, not the other way round. Verified, not assumed — with
# VITE_FB_PROJECT_ID set in both, a production build resolves the value from
# .env.production.
#
# So:
#   - to point `npm run dev` and the tests at something else, use .env.local
#   - to point a PRODUCTION BUILD at something else, .env.local will NOT work
#     for any key that .env.production also sets. Use .env.production.local,
#     which is what CI writes from repo secrets.
#
# IMPORTANT: every VITE_-prefixed variable is inlined into the JavaScript
# bundle that ships to the browser. Anyone can read them with devtools. None of
# these are secrets — the Firebase web config is public by design, and access
# is controlled by the Firestore/Storage rules and the callables, not by hiding
# these values. Never put an API secret, service-account key or admin
# credential in a VITE_ variable.
#
# These five are the complete set the app reads. (import.meta.env.DEV is also
# used, but that is Vite's own built-in flag, not something you configure.)

# 1 = talk to the local emulators (127.0.0.1). Empty/absent = talk to the real
# project named below. Must be EMPTY for anything you deploy, or phones will
# try to reach 127.0.0.1.
VITE_USE_EMULATORS=1

# The Firebase project these point at. With emulators on, the values only need
# to be well-formed — nothing contacts Google.
VITE_FB_PROJECT_ID=money-kids-test
VITE_FB_API_KEY=demo-key
VITE_FB_AUTH_DOMAIN=localhost
VITE_FB_STORAGE_BUCKET=money-kids-test.appspot.com

# For a real project: `firebase apps:sdkconfig web --project <id>` gives these
# values, and VITE_USE_EMULATORS must be empty. Be aware you are then reading
# and writing real family data.
