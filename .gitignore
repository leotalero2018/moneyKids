node_modules/
dist/
*.log
.firebase/
firebase-debug.log
ui-debug.log

# generated by CI from repo secrets
# Vite treats *.local as personal and never-committed. Listed as a glob rather
# than one filename so a new app/.env.local — the file you would put real
# project config in — cannot be committed by accident.
*.local
functions/deploy/*
!functions/deploy/.gitkeep
