{
  "name": "@money-kids/functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "node scripts/stage.mjs",
    "build:deploy": "node scripts/stage.mjs --strict && node scripts/smoke.mjs deploy",
    "smoke": "node scripts/smoke.mjs deploy",
    "stage:lock": "node scripts/stage.mjs --refresh-lock",
    "test": "vitest run",
    "test:staging": "vitest run --config vitest.staging.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@money-kids/shared": "*",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
